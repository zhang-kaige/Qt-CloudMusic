#include "bottombar.h"
#include "ui_bottombar.h"
#include "QDebug"
#include <QPainter>
#include <QPainterPath>
#include "rotatelabel.h"

BottomBar::BottomBar(QWidget *parent) :
    QWidget(parent),
    ui(new Ui::BottomBar)
{
    ui->setupUi(this);
    auto pb = ui->pauseBtn;
    ui->nextBtn->setIcon(QIcon(":/images/traynext.png"));
    ui->lastBtn->setIcon(QIcon(":/images/traylast.png"));
    ui->loveBtn->setIcon(QIcon(":/images/love.svg"));
    ui->styleBtn->setIcon(QIcon(":/images/flash.svg"));
    // 1) 基本属性
    pb->setObjectName("pb");                         // 若用 #pb 选择器必须有
    pb->setToolButtonStyle(Qt::ToolButtonIconOnly);
    pb->setAutoRaise(true);
    pb->setFocusPolicy(Qt::NoFocus);
    pb->setCursor(Qt::PointingHandCursor);
    pb->setCheckable(true);                          // 需要 :checked 才生效

    // 2) 图标与尺寸
    pb->setIcon(QIcon(":/images/action.svg"));    // PNG 就用白色素材，或改用 SVG+currentColor
    pb->setIconSize(QSize(22,22));                   // 按需

    // 3) 样式表
    pb->setStyleSheet(
        "#pb{"
        "  background:#ff3b5c;"
        "  color:white;"                /* 若是SVG+currentColor可生效 */
        "  border:none;"
        "  border-radius:24px;"         /* 半径=尺寸一半 → 圆 */
        "  min-width:48px; min-height:48px;"
        "  max-width:48px; max-height:48px;"
        "  padding:0;"
        "}"
        "#pb:hover{ background:#ff2f52; }"
        "#pb:pressed{ background:#e52845; }"
        "#pb:disabled{ background:#e0e0e0; color:#bdbdbd; }"
        "#pb:checked{ background:#ff3b5c; }"
    );


//    connect()
}

BottomBar::~BottomBar()
{
    delete ui;
}

void BottomBar::setSongInfo(const QString &title, const QString &artist, const QString &coverPath)
{
    qDebug() << coverPath;
    ui->songLab->setText(title);
    ui->songerLab->setText("-" + artist);
    QPixmap pm(coverPath);
    int size = ui->coverLab->width();   // 封面控件的边长

    // ⭐ 生成圆形封面
    QPixmap round = makeRoundPixmap(pm, size);

    ui->coverLab->setPixmap(round);

    // ⭐ 外圈黑色边框（用样式表即可）
    ui->coverLab->setStyleSheet(
       "border: 3px solid black;"
       "border-radius: " + QString::number(size/2) + "px;"
    );
}

QPixmap BottomBar::makeRoundPixmap(const QPixmap &src, int size)
{
    QPixmap scaled = src.scaled(size, size, Qt::KeepAspectRatioByExpanding, Qt::SmoothTransformation);
    QPixmap result(size, size);
    result.fill(Qt::transparent);   

    QPainter p(&result);
    p.setRenderHints(QPainter::Antialiasing | QPainter::SmoothPixmapTransform);

    // 圆形路径
    QPainterPath path;
    path.addEllipse(0, 0, size, size);
    p.setClipPath(path);

    // 画图片
    p.drawPixmap(0, 0, scaled);

    return result;
}

void BottomBar::startCoverRotate()
{
    ui->coverLab->startRotate();
}
